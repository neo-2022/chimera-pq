#!/usr/bin/env bash
set -euo pipefail

resolve_self() {
  local src="${BASH_SOURCE[0]}"
  while [[ -L "$src" ]]; do
    local dir
    dir="$(cd "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd "$(dirname "$src")" && pwd
}

SCRIPT_DIR="$(resolve_self)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
CONTROL="$ROOT_DIR/scripts/chimera-control.sh"
INSTALLER="$ROOT_DIR/scripts/install_desktop_control.sh"
RUNTIME_VERSION_FILE="$ROOT_DIR/.chimera_release_version"
RUNTIME_BUNDLE_SHA_FILE="$ROOT_DIR/.chimera_release_bundle.sha256"
INSTALL_NODE_ROLE_FILE="$ROOT_DIR/.chimera_install_role"
UPDATE_MODULE="$ROOT_DIR/scripts/chimera-update.sh"

load_update_module() {
  UPDATE_MODULE="$ROOT_DIR/scripts/chimera-update.sh"
  if [[ -f "$UPDATE_MODULE" ]]; then
    # shellcheck source=/dev/null
    source "$UPDATE_MODULE"
    return 0
  fi
  auto_update_if_needed() {
    echo "chimera_update=source_invalid action=block reason=missing_update_module" >&2
    return 1
  }
}

load_update_module

usage() {
  cat <<'EOF'
Usage:
  chimera-sh -install
  chimera-sh -start
  chimera-sh -stop
  chimera-sh -restart
  chimera-sh -status
  chimera-sh -mesh <args...>
  chimera-sh -connect <index|node_id> [mesh node filters...]
  chimera-sh -mesh-bind-control-plane [--strict|--best-effort]
  chimera-sh -version
  chimera-sh -doctor
  chimera-sh -logs
  chimera-sh -uninstall
  chimera-sh -help
EOF
}

require_file() {
  local path="$1"
  if [[ ! -f "$path" ]]; then
    echo "error: required file not found: $path" >&2
    exit 1
  fi
}

ensure_runtime_files() {
  local missing=0
  [[ -f "$CONTROL" ]] || missing=1
  [[ -f "$INSTALLER" ]] || missing=1
  [[ "$missing" -eq 0 ]] && return 0

  # Best effort self-heal for stale local launcher links.
  if [[ -n "${HOME:-}" ]]; then
    local legacy_root="${HOME}/.local"
    local legacy_control="${legacy_root}/scripts/chimera-control.sh"
    local legacy_installer="${legacy_root}/scripts/install_desktop_control.sh"
    if [[ -f "$legacy_control" && -f "$legacy_installer" ]]; then
      ROOT_DIR="$legacy_root"
      CONTROL="$legacy_control"
      INSTALLER="$legacy_installer"
      RUNTIME_VERSION_FILE="$ROOT_DIR/.chimera_release_version"
      RUNTIME_BUNDLE_SHA_FILE="$ROOT_DIR/.chimera_release_bundle.sha256"
      INSTALL_NODE_ROLE_FILE="$ROOT_DIR/.chimera_install_role"
      load_update_module
      missing=0
    fi
  fi

  if [[ "$missing" -ne 0 ]]; then
    return 1
  fi
  return 0
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    -install)
      require_file "$INSTALLER"
      exec "$INSTALLER" "${@:2}"
      ;;
    -start)
      ensure_runtime_files || {
        echo "error: CHIMERA runtime files are missing. Run: chimera-sh -install" >&2
        exit 1
      }
      require_file "$CONTROL"
      auto_update_if_needed -start || {
        echo "error: CHIMERA runtime is not aligned with latest release. Update required before start." >&2
        exit 1
      }
      CHIMERA_UPDATE_FIRST_CHECKED=1 exec "$CONTROL" start
      ;;
    -stop)
      ensure_runtime_files || {
        echo "error: CHIMERA runtime files are missing. Run: chimera-sh -install" >&2
        exit 1
      }
      require_file "$CONTROL"
      exec "$CONTROL" stop
      ;;
    -restart)
      ensure_runtime_files || {
        echo "error: CHIMERA runtime files are missing. Run: chimera-sh -install" >&2
        exit 1
      }
      require_file "$CONTROL"
      auto_update_if_needed -restart || {
        echo "error: CHIMERA runtime is not aligned with latest release. Update required before restart." >&2
        exit 1
      }
      CHIMERA_UPDATE_FIRST_CHECKED=1 exec "$CONTROL" restart
      ;;
    -mesh|mesh)
      ensure_runtime_files || {
        echo "error: CHIMERA runtime files are missing. Run: chimera-sh -install" >&2
        exit 1
      }
      require_file "$CONTROL"
      auto_update_if_needed "$cmd" "${@:2}" || {
        echo "error: CHIMERA runtime is not aligned with latest release. Update required before mesh command." >&2
        exit 1
      }
      CHIMERA_UPDATE_FIRST_CHECKED=1 exec "$CONTROL" mesh "${@:2}"
      ;;
    -connect|connect)
      ensure_runtime_files || {
        echo "error: CHIMERA runtime files are missing. Run: chimera-sh -install" >&2
        exit 1
      }
      require_file "$CONTROL"
      auto_update_if_needed "$cmd" "${@:2}" || {
        echo "error: CHIMERA runtime is not aligned with latest release. Update required before connect." >&2
        exit 1
      }
      CHIMERA_UPDATE_FIRST_CHECKED=1 exec "$CONTROL" mesh nodes connect "${@:2}"
      ;;
    -mesh-bind-control-plane|mesh-bind-control-plane)
      ensure_runtime_files || {
        echo "error: CHIMERA runtime files are missing. Run: chimera-sh -install" >&2
        exit 1
      }
      require_file "$CONTROL"
      auto_update_if_needed "$cmd" "${@:2}" || {
        echo "error: CHIMERA runtime is not aligned with latest release. Update required before mesh bind control-plane." >&2
        exit 1
      }
      CHIMERA_UPDATE_FIRST_CHECKED=1 exec "$CONTROL" mesh-bind-control-plane "${@:2}"
      ;;
    -status)
      ensure_runtime_files || {
        echo "error: CHIMERA runtime files are missing. Run: chimera-sh -install" >&2
        exit 1
      }
      require_file "$CONTROL"
      exec "$CONTROL" status
      ;;
    -doctor)
      ensure_runtime_files || {
        echo "error: CHIMERA runtime files are missing. Run: chimera-sh -install" >&2
        exit 1
      }
      require_file "$CONTROL"
      exec "$CONTROL" doctor
      ;;
    -logs)
      ensure_runtime_files || {
        echo "error: CHIMERA runtime files are missing. Run: chimera-sh -install" >&2
        exit 1
      }
      require_file "$CONTROL"
      exec "$CONTROL" logs
      ;;
    -version)
      local current="unknown"
      if [[ -f "$RUNTIME_VERSION_FILE" ]]; then
        current="$(tr -d '[:space:]' < "$RUNTIME_VERSION_FILE")"
      fi
      echo "chimera-runtime ${current}"
      ;;
    -uninstall)
      ensure_runtime_files || {
        echo "error: CHIMERA runtime files are missing. Run: chimera-sh -install" >&2
        exit 1
      }
      require_file "$CONTROL"
      exec "$CONTROL" uninstall
      ;;
    -help|--help|help|"")
      usage
      ;;
    *)
      echo "error: unknown option: $cmd" >&2
      usage
      exit 1
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
