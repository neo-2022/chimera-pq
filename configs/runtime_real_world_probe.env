# Runtime real-world probe defaults (can be overridden by environment variables).
# Default mode is live. GitHub CI may set CHIMERA_REAL_WORLD_PROBE_MODE=ci_snapshot
# for a non-live contract snapshot; SSH side_b/SIDE_A stand checks must use live mode.
CHIMERA_REAL_WORLD_OUT_JSON=docs/RUNTIME_REAL_WORLD_PROBE_SMOKE.json
CHIMERA_REAL_WORLD_DIRECT_URL=https://example.org
CHIMERA_REAL_WORLD_DATAPATH_TARGETS=https://www.youtube.com,https://discord.com,https://chat.openai.com
CHIMERA_REAL_WORLD_DIRECT_TIMEOUT_SEC=8
CHIMERA_REAL_WORLD_DATAPATH_TIMEOUT_SEC=12
