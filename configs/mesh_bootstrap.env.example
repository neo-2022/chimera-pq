# CHIMERA/WEAVE mesh bootstrap example.
# Copy to ~/.config/chimera/mesh_bootstrap.env and fill from a private operator
# seed or signed discovery manifest. Product defaults intentionally do not bake
# a public discovery URL, stand host, account, password, or proxy/upstream path.

# Optional: signed mesh node discovery source.
# CHIMERA_MESH_NODES_DISCOVERY_URL=
# CHIMERA_MESH_NODES_DISCOVERY_PUBKEY=
# CHIMERA_MESH_NODES_DISCOVERY_KEYRING=
# CHIMERA_MESH_NODES_PROBE_TIMEOUT_MS=4000

# Optional: direct peer endpoint supplied by operator/private state.
# CHIMERA_NODE_ENDPOINT=
# CHIMERA_PEER_ENDPOINT=
# CHIMERA_MESH_REMOTE_ENDPOINT=
