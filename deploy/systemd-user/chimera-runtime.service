[Unit]
Description=CHIMERA Runtime Orchestrator (user service)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
WorkingDirectory=__CHIMERA_ROOT__
Environment=CHIMERA_FAIL_CLOSED_ON_PARTIAL_START=0
Environment=CHIMERA_APPLY_TUN=false
Environment=CHIMERA_APPLY_ROUTE=false
Environment=CHIMERA_APPLY_DNS=false
ExecStart=/usr/bin/env bash -lc 'exec ./scripts/chimera-control.sh start'
ExecStop=/usr/bin/env bash -lc 'exec ./scripts/chimera-control.sh stop'
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=default.target
